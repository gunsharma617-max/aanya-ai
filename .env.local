# SERVER ONLY — configure these in your existing Next.js Aanya backend.
# This Vite frontend does not read or bundle these values.
# Copy this file to .env.local in the SERVER project, not into a public folder.

NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813
AI_API_KEY=

# Existing backend contracts retained:
# NVIDIA endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Gemini TTS model: gemini-3.1-flash-tts-preview
# Gemini voice: Leda
# Never prefix API secrets with VITE_ or NEXT_PUBLIC_.
# Never commit .env.local or put credentials in the frontend Settings URL.
